{
  "name": "frontend-developer",
  "description": "Web front-end toolkit: React/Next, Vue/Nuxt, Svelte, Angular, TypeScript, modern CSS/Tailwind.",
  "version": "1.3.1",
  "author": {
    "name": "IGRSoft",
    "email": "support@igrsoft.com"
  },
  "license": "Apache-2.0",
  "keywords": [
    "react",
    "nextjs",
    "vue",
    "svelte",
    "angular",
    "typescript",
    "tailwind",
    "vite",
    "webpack",
    "playwright",
    "vitest",
    "wcag",
    "accessibility",
    "core-web-vitals",
    "dr-stage",
    "security-review",
    "hooks",
    "qualified-agent-refs"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|TaskUpdate|TaskCreate",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/audit-tooluse.sh",
            "args": [
              "--kind",
              "tool"
            ],
            "continueOnBlock": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/audit-subagent.sh",
            "continueOnBlock": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/precompact-checkpoint.sh"
          }
        ]
      }
    ]
  }
}
